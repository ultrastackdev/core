{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "target": "es2022",
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./*"],
      "@entities": ["libs/entities/src"],
      "@enums": ["libs/enums/src"],
      "@interfaces": ["libs/interfaces/src"],
      "@constants": ["libs/constants/src"],
      "@schemas": ["libs/schemas/src"],
      "@shared/front": ["libs/frontend-shared/src"],
      "@shared/front/*": ["libs/frontend-shared/src/*"]
    },
    "customConditions": ["@ultrastack"]
  }
}
