{
  "name": "@new-ultrastack/app-mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/app-mobile",
  "projectType": "application",
  "tags": [],
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});\""
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [{ "command": "tsc -p tsconfig.json --noEmit", "forwardAllArgs": false }],
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["clean", "^typecheck"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "fix": false,
        "lintFilePatterns": [
          "{projectRoot}/src/**/*.{ts,tsx,js,jsx}",
          "{projectRoot}/*.{ts,tsx,js,mjs}",
          "{projectRoot}/scripts/**/*.{ts,js}"
        ]
      },
      "dependsOn": ["typecheck"]
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "development",
      "options": {
        "outputPath": "{projectRoot}/dist"
      },
      "configurations": {
        "development": {
          "tags": ["app-mobile:latest"]
        },
        "production": {
          "tags": ["app-mobile:latest"]
        }
      },
      "dependsOn": ["lint"]
    },
    "serve": {
      "options": { "port": 4200, "hostname": "0.0.0.0" }
    },
    "android-add": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap add android",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"]
    },
    "android-remove": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap remove android",
        "cwd": "{projectRoot}"
      }
    },
    "ios-add": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap add ios",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"]
    },
    "ios-remove": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap remove ios",
        "cwd": "{projectRoot}"
      }
    },
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap sync",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"]
    },
    "android-sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap sync android",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"]
    },
    "ios-sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap sync ios",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"]
    },
    "android-run-live-emulator": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap run android -l --host=10.0.2.2 --port=4000",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["serve"]
    },
    "android-run-live-target": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/cross-var.js npx cap run android -l --port=4000 --host=$HOST",
        "cwd": "{projectRoot}",
        "args": ["--target"],
        "envFile": "{projectRoot}/.env"
      },
      "dependsOn": ["serve"]
    },
    "ios-run-live-emulator": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap run ios -l --port=4000",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["serve"]
    },
    "ios-run-live-target": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap run ios -l --port=4000",
        "cwd": "{projectRoot}",
        "args": ["--target"]
      },
      "dependsOn": ["serve"]
    },
    "android-open": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap open android",
        "cwd": "{projectRoot}"
      }
    },
    "ios-open": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap open ios",
        "cwd": "{projectRoot}"
      }
    },
    "android-doctor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap doctor android",
        "cwd": "{projectRoot}"
      }
    },
    "ios-doctor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap doctor ios",
        "cwd": "{projectRoot}"
      }
    },
    "build-android-app": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./gradlew assembleDebug",
        "cwd": "{projectRoot}/android"
      },
      "dependsOn": ["android-sync"]
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "options": {
        "engine": "docker",
        "context": "{projectRoot}",
        "metadata": {
          "images": ["app-mobile"],
          "load": true,
          "tags": [
            "type=schedule",
            "type=ref,event=branch",
            "type=ref,event=tag",
            "type=ref,event=pr",
            "type=sha,prefix=sha-"
          ]
        }
      }
    }
  }
}
